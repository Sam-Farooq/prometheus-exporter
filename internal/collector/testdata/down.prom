# HELP pg_exporter_build_info Always 1. The version label is the exporter build serving this endpoint, so a stale binary on one host is visible without logging in.
# TYPE pg_exporter_build_info gauge
pg_exporter_build_info{version="0.16.4-test"} 1
# HELP pg_exporter_collector_success 1 when this collector's queries all returned. A 0 here with pg_up at 1 is a permission or a timeout on one view, not an unreachable server.
# TYPE pg_exporter_collector_success gauge
pg_exporter_collector_success{collector="bloat"} 0
pg_exporter_collector_success{collector="connect"} 0
pg_exporter_collector_success{collector="replication"} 0
pg_exporter_collector_success{collector="wraparound"} 0
# HELP pg_exporter_scrape_errors_total Failed scrapes per collector since the process started. Present at zero from the first scrape, so an increase() over a window that starts before the first failure has a baseline to compare against.
# TYPE pg_exporter_scrape_errors_total counter
pg_exporter_scrape_errors_total{collector="bloat"} 0
pg_exporter_scrape_errors_total{collector="connect"} 1
pg_exporter_scrape_errors_total{collector="replication"} 0
pg_exporter_scrape_errors_total{collector="wraparound"} 0
# HELP pg_exporter_scrapes_total Scrapes of this endpoint since the process started. Divide the error counter by this to get a failure rate that does not depend on the scrape interval.
# TYPE pg_exporter_scrapes_total counter
pg_exporter_scrapes_total 1
# HELP pg_up 1 when the server answered a ping inside the scrape timeout. 0 means every value below it is missing for a reason, which is the difference between a down database and a quiet one.
# TYPE pg_up gauge
pg_up 0
