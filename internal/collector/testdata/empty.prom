# HELP pg_autovacuum_freeze_max_age_transactions The server's autovacuum_freeze_max_age. Exported rather than assumed because the default is not what a tuned server runs, and the ratio is meaningless against the wrong denominator.
# TYPE pg_autovacuum_freeze_max_age_transactions gauge
pg_autovacuum_freeze_max_age_transactions 2e+08
# HELP pg_exporter_build_info Always 1. The version label is the exporter build serving this endpoint, so a stale binary on one host is visible without logging in.
# TYPE pg_exporter_build_info gauge
pg_exporter_build_info{version="0.16.4-test"} 1
# HELP pg_exporter_collector_success 1 when this collector's queries all returned. A 0 here with pg_up at 1 is a permission or a timeout on one view, not an unreachable server.
# TYPE pg_exporter_collector_success gauge
pg_exporter_collector_success{collector="bloat"} 1
pg_exporter_collector_success{collector="connect"} 1
pg_exporter_collector_success{collector="replication"} 1
pg_exporter_collector_success{collector="wraparound"} 1
# HELP pg_exporter_scrape_errors_total Failed scrapes per collector since the process started. Present at zero from the first scrape, so an increase() over a window that starts before the first failure has a baseline to compare against.
# TYPE pg_exporter_scrape_errors_total counter
pg_exporter_scrape_errors_total{collector="bloat"} 0
pg_exporter_scrape_errors_total{collector="connect"} 0
pg_exporter_scrape_errors_total{collector="replication"} 0
pg_exporter_scrape_errors_total{collector="wraparound"} 0
# HELP pg_exporter_scrapes_total Scrapes of this endpoint since the process started. Divide the error counter by this to get a failure rate that does not depend on the scrape interval.
# TYPE pg_exporter_scrapes_total counter
pg_exporter_scrapes_total 1
# HELP pg_in_recovery 1 when this server is a standby. The replication metrics below describe outbound replication, so on a standby they describe cascading replicas rather than the server's own lag.
# TYPE pg_in_recovery gauge
pg_in_recovery 0
# HELP pg_replication_standbys Walsenders in each replication state. Alert on the streaming count falling, not on lag rising: a standby that disconnects stops reporting lag entirely and its lag series goes away.
# TYPE pg_replication_standbys gauge
pg_replication_standbys{state="backup"} 0
pg_replication_standbys{state="catchup"} 0
pg_replication_standbys{state="startup"} 0
pg_replication_standbys{state="stopping"} 0
pg_replication_standbys{state="streaming"} 0
pg_replication_standbys{state="unknown"} 0
# HELP pg_replication_standbys_folded Walsenders that shared an application_name with another and were merged into one series, keeping the larger lag. Non-zero means two standbys are reporting as one, and the fix is a distinct application_name in their primary_conninfo.
# TYPE pg_replication_standbys_folded gauge
pg_replication_standbys_folded 0
# HELP pg_table_series_omitted Tables that passed the size filter and fell outside the row cap. Non-zero means the table metrics above are a top-N by size, not every table on the server.
# TYPE pg_table_series_omitted gauge
pg_table_series_omitted 0
# HELP pg_up 1 when the server answered a ping inside the scrape timeout. 0 means every value below it is missing for a reason, which is the difference between a down database and a quiet one.
# TYPE pg_up gauge
pg_up 1
