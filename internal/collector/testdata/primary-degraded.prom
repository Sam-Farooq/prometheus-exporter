# HELP pg_autovacuum_freeze_max_age_transactions The server's autovacuum_freeze_max_age. Exported rather than assumed because the default is not what a tuned server runs, and the ratio is meaningless against the wrong denominator.
# TYPE pg_autovacuum_freeze_max_age_transactions gauge
pg_autovacuum_freeze_max_age_transactions 2e+08
# HELP pg_database_xid_age_transactions Transactions since this database's oldest unfrozen transaction id. Divide by pg_autovacuum_freeze_max_age_transactions to see how close the server is to forcing vacuums; at two billion it stops accepting writes.
# TYPE pg_database_xid_age_transactions gauge
pg_database_xid_age_transactions{datname="app"} 1.78e+08
pg_database_xid_age_transactions{datname="postgres"} 240000
# HELP pg_exporter_build_info Always 1. The version label is the exporter build serving this endpoint, so a stale binary on one host is visible without logging in.
# TYPE pg_exporter_build_info gauge
pg_exporter_build_info{version="0.13.2-test"} 1
# HELP pg_exporter_collector_success 1 when this collector's queries all returned. A 0 here with pg_up at 1 is a permission or a timeout on one view, not an unreachable server.
# TYPE pg_exporter_collector_success gauge
pg_exporter_collector_success{collector="bloat"} 1
pg_exporter_collector_success{collector="connect"} 1
pg_exporter_collector_success{collector="replication"} 1
pg_exporter_collector_success{collector="wraparound"} 1
# HELP pg_exporter_scrape_errors_total Failed scrapes per collector since the process started. Present at zero from the first scrape, so an increase() over a window that starts before the first failure has a baseline to compare against.
# TYPE pg_exporter_scrape_errors_total counter
pg_exporter_scrape_errors_total{collector="bloat"} 0
pg_exporter_scrape_errors_total{collector="connect"} 0
pg_exporter_scrape_errors_total{collector="replication"} 0
pg_exporter_scrape_errors_total{collector="wraparound"} 0
# HELP pg_exporter_scrapes_total Scrapes of this endpoint since the process started. Divide the error counter by this to get a failure rate that does not depend on the scrape interval.
# TYPE pg_exporter_scrapes_total counter
pg_exporter_scrapes_total 1
# HELP pg_in_recovery 1 when this server is a standby. The replication metrics below describe outbound replication, so on a standby they describe cascading replicas rather than the server's own lag.
# TYPE pg_in_recovery gauge
pg_in_recovery 0
# HELP pg_replication_slot_active 1 when a consumer is attached to this slot. A 0 on a logical slot is the condition under which retained WAL grows without limit until the data directory fills.
# TYPE pg_replication_slot_active gauge
pg_replication_slot_active{slot_name="cdc_orders",slot_type="logical"} 0
pg_replication_slot_active{slot_name="old_replica",slot_type="physical"} 0
# HELP pg_replication_slot_retained_wal_bytes WAL the server is keeping because this slot has not consumed it. This is the number that fills a disk, and it is retained whether or not anything is listening.
# TYPE pg_replication_slot_retained_wal_bytes gauge
pg_replication_slot_retained_wal_bytes{slot_name="cdc_orders",slot_type="logical"} 4.294967296e+10
pg_replication_slot_retained_wal_bytes{slot_name="old_replica",slot_type="physical"} 8.589934592e+09
# HELP pg_replication_standby_lag_bytes WAL bytes written on this server that the standby has not replayed, from LSN arithmetic. Always available, unlike the seconds form, so this is the one to alert on.
# TYPE pg_replication_standby_lag_bytes gauge
pg_replication_standby_lag_bytes{application_name="replica-c"} 5.36870912e+08
pg_replication_standby_lag_bytes{application_name="walreceiver"} 2.147483648e+09
# HELP pg_replication_standby_replay_lag_seconds Delay between a commit here and its replay on the standby, as the standby last reported it. Absent when the standby has not reported since the last WAL write, so a missing value is silence and not zero.
# TYPE pg_replication_standby_replay_lag_seconds gauge
pg_replication_standby_replay_lag_seconds{application_name="walreceiver"} 11.5
# HELP pg_replication_standbys Walsenders in each replication state. Alert on the streaming count falling, not on lag rising: a standby that disconnects stops reporting lag entirely and its lag series goes away.
# TYPE pg_replication_standbys gauge
pg_replication_standbys{state="backup"} 0
pg_replication_standbys{state="catchup"} 1
pg_replication_standbys{state="startup"} 0
pg_replication_standbys{state="stopping"} 0
pg_replication_standbys{state="streaming"} 2
pg_replication_standbys{state="unknown"} 0
# HELP pg_replication_standbys_folded Walsenders that shared an application_name with another and were merged into one series, keeping the larger lag. Non-zero means two standbys are reporting as one, and the fix is a distinct application_name in their primary_conninfo.
# TYPE pg_replication_standbys_folded gauge
pg_replication_standbys_folded 1
# HELP pg_table_autovacuum_threshold_rows Dead rows at which autovacuum would pick this table up, from the server-wide threshold and scale factor. A table over its threshold and not recently vacuumed is the actionable case; dead rows on their own are not.
# TYPE pg_table_autovacuum_threshold_rows gauge
pg_table_autovacuum_threshold_rows{schema="public",table="events"} 1.900005e+07
pg_table_autovacuum_threshold_rows{schema="public",table="sessions"} 400050
# HELP pg_table_autovacuums_total Autovacuums of this table since the last statistics reset. A rate of zero on a table above its threshold means autovacuum is not reaching it.
# TYPE pg_table_autovacuums_total gauge
pg_table_autovacuums_total{schema="public",table="events"} 0
pg_table_autovacuums_total{schema="public",table="sessions"} 2
# HELP pg_table_dead_rows Dead rows the statistics collector believes this table holds. An estimate, not a count, and zero immediately after a statistics reset on a table that is full of them.
# TYPE pg_table_dead_rows gauge
pg_table_dead_rows{schema="public",table="events"} 4.1e+07
pg_table_dead_rows{schema="public",table="sessions"} 7.5e+06
# HELP pg_table_last_autovacuum_timestamp_seconds Unix time of the last autovacuum of this table. Absent for a table autovacuum has never processed, which on a large table is itself the finding.
# TYPE pg_table_last_autovacuum_timestamp_seconds gauge
pg_table_last_autovacuum_timestamp_seconds{schema="public",table="sessions"} 1.7894256e+09
# HELP pg_table_live_rows Live rows the statistics collector believes this table holds. Present because the autovacuum threshold is a function of it, so dead rows alone cannot be read.
# TYPE pg_table_live_rows gauge
pg_table_live_rows{schema="public",table="events"} 9.5e+07
pg_table_live_rows{schema="public",table="sessions"} 2e+06
# HELP pg_table_series_omitted Tables that passed the size filter and fell outside the row cap. Non-zero means the table metrics above are a top-N by size, not every table on the server.
# TYPE pg_table_series_omitted gauge
pg_table_series_omitted 0
# HELP pg_table_size_bytes Total relation size including indexes and TOAST. Growth with a flat live row count is bloat taking space that a vacuum will not give back to the filesystem.
# TYPE pg_table_size_bytes gauge
pg_table_size_bytes{schema="public",table="events"} 2.147483648e+11
pg_table_size_bytes{schema="public",table="sessions"} 3.221225472e+10
# HELP pg_up 1 when the server answered a ping inside the scrape timeout. 0 means every value below it is missing for a reason, which is the difference between a down database and a quiet one.
# TYPE pg_up gauge
pg_up 1
